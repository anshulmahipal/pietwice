{
  "name": "bondwallet",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "test": "jest --watchAll=false",
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android",
    "prebuild:ios": "expo prebuild --platform ios",
    "prebuild:web": "expo prebuild --platform web",
    "prebuild:all": "expo prebuild --platform android --platform ios --platform web",
    "prebuild:clean": "expo prebuild --clean",
    "prebuild:clean:android": "expo prebuild --clean --platform android",
    "prebuild:clean:ios": "expo prebuild --clean --platform ios",
    "prebuild:clean:web": "expo prebuild --clean --platform web",
    "prebuild:clean:all": "expo prebuild --clean --platform android --platform ios --platform web",
    "update:production": "eas update --channel production",
    "update:preview": "eas update --channel preview",
    "deploy:marketing": "npx vercel deploy --prod --name bondwallet",
    "eas:android:preview": "eas build -p android --profile preview"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.15.6",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.14.6",
    "@vercel/analytics": "^2.0.1",
    "expo": "~54.0.0",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-notifications": "~0.32.16",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1314.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "typescript": "~5.9.2"
  },
